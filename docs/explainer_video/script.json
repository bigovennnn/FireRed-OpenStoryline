  "subs": [
    { "s": 0.8,  "e": 4.2,  "text": "嗨～我是 Claude！✨" },
    { "s": 4.2,  "e": 7.8,  "text": "今天带你看看 FireRed-OpenStoryline 的小秘密" },

    { "s": 8.4,  "e": 11.8, "text": "你只需要像聊天一样，说出想要的视频" },
    { "s": 11.8, "e": 15.5, "text": "大脑是一个 LLM Agent，负责思考和决策" },
    { "s": 15.5, "e": 19.0, "text": "它的手，是 MCP Server 上的一排剪辑工具" },
    { "s": 19.0, "e": 21.8, "text": "每一步的产物，都存进 ArtifactStore" },

    { "s": 22.4, "e": 25.8, "text": "第一步：找素材！本地导入，或上网搜" },
    { "s": 25.8, "e": 29.6, "text": "TransNetV2 把长视频切成一个个镜头" },
    { "s": 29.6, "e": 33.6, "text": "视觉模型 VLM 逐个看懂镜头里有什么" },
    { "s": 33.6, "e": 37.6, "text": "再按你的要求，挑出好镜头、分好组" },

    { "s": 38.4, "e": 42.0, "text": "接着写文案，还能模仿你给的参考风格哦" },
    { "s": 42.0, "e": 45.6, "text": "文案变成配音，TTS 张嘴就来" },
    { "s": 45.6, "e": 49.4, "text": "挑一首 BGM，再把鼓点一个个找出来" },
    { "s": 49.4, "e": 51.8, "text": "画面跟着节拍走，才有感觉嘛～" },

    { "s": 52.4, "e": 56.0, "text": "规划时间线：镜头、配音、音乐对齐卡点" },
    { "s": 56.0, "e": 59.6, "text": "再配上转场和花字特效" },
    { "s": 59.6, "e": 63.6, "text": "最后 render_video 一渲染，成片出炉！🎬" },

    { "s": 64.4, "e": 67.8, "text": "每个工具都写好了自己的“前置依赖”" },
    { "s": 67.8, "e": 71.4, "text": "缺了哪一步，拦截器会自动先补上" },
    { "s": 71.4, "e": 74.6, "text": "补跑用稳妥的 default 模式，不会卡住" },

    { "s": 75.4, "e": 78.8, "text": "不满意？直接说“把第二段换掉”就行" },
    { "s": 78.8, "e": 81.8, "text": "颜色、字体、位置，全都能动嘴改" },
    { "s": 81.8, "e": 84.6, "text": "喜欢的剪法，还能存成 Skill 一键复用" },

    { "s": 85.4, "e": 88.6, "text": "星星之火，可以燎原 🔥" },
    { "s": 88.6, "e": 91.8, "text": "一起来玩 FireRed-OpenStoryline 吧！" }
  ]
}
